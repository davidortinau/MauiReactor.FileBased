<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>MauiReactor.FileBased.Sdk</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Authors>David Ortinau</Authors>
    <Description>Experimental file-based MauiReactor SDK with native startup and default Apple scene metadata.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/davidortinau/MauiReactor.FileBased</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/davidortinau/MauiReactor.FileBased</PackageProjectUrl>
    <IsPackable>true</IsPackable>
    <IsShipping>false</IsShipping>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="build/**" Pack="true" PackagePath="build/" />
    <None Include="Sdk/**" Pack="true" PackagePath="Sdk/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
