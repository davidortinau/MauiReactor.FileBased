{
  "$schema": "http://json.schemastore.org/template",
  "author": "David Ortinau",
  "classifications": ["MAUI", "MauiReactor", "File-based", "Mac Catalyst"],
  "identity": "davidortinau.MauiReactor.FileBased",
  "name": "MauiReactor file-based app (experimental)",
  "description": "A native Mac Catalyst counter in one C# file, with the MauiReactor preview SDK from GitHub Packages.",
  "shortName": "maui-reactor-file",
  "defaultName": "ReactorFileApp",
  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "include": ["app.cs", "Resources/**"],
      "copyOnly": ["Resources/**"]
    }
  ],
  "primaryOutputs": [
    {
      "path": "app.cs"
    }
  ]
}
